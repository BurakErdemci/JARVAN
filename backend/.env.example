GEMINI_API_KEY=your_gemini_api_key_here

# Antigravity CLI (agy) — arka plan dev/araştırma worker'ı
# Binary PATH'te değilse açıkça ver (Windows kurulumu: %LOCALAPPDATA%\agy\bin\agy.exe).
# Boş bırakılırsa worker otomatik bulur.
# AGY_BIN=
# agy --print BİLİNEN BUG (Issue #76): non-TTY'de cevabı stdout'a yazmaz → worker cevabı
# agy'nin transcript dosyasından okur. Konum standart değilse override et:
# AGY_HOME=~/.gemini/antigravity-cli
# Model display isimleri (agy models çıktısından)
AGY_MODEL_FAST=Gemini 3.5 Flash (Medium)
AGY_MODEL_HEAVY=Gemini 3.1 Pro (High)
# Ağır görevler için print-mode zaman aşımı (büyük refactor / derin araştırma)
AGY_PRINT_TIMEOUT=30m

# ─── Çok-hedefli dispatch ("beyinler": agy / codex / claude) ─────────────
# Gemma dispatcher target seçer; ağır iş abonelikli CLI'ya gider.
# DISPATCH_DEFAULT_TARGET=gpt          # target boş gelirse kullanılacak beyin
#
# gpt → Codex (ChatGPT Plus/Pro aboneliğine DAHİL, hassas kod/test/terminal):
#   codex login          # bir kez (ChatGPT hesabınla)
# CODEX_BIN=codex
# CODEX_ARGS=exec --full-auto --json   # non-interactive, JSON çıktı, workspace otonom
#
# claude → Claude Code (Opus; büyük refactor/mimari). `claude "<prompt>"` (-p YOK):
# TTY yokken otomatik non-interactive çıktıya düşüyor, PTY GEREKMEZ (canlı doğrulandı).
# ⚠️ FATURALAMA BELİRSİZ: çıktı `-p` ile aynı; TTY olmadığı için MUHTEMELEN yine ücretli
# API havuzuna düşer (15 Haz 2026 değişikliği). AÇMADAN ÖNCE tek çağrı yapıp Claude usage
# panelinden faturanın aboneliğe mi yoksa ücretli havuza mı gittiğini DOĞRULA.
# CLAUDE_ENABLED=0                     # 1 yap → claude hedefi açılır (önce faturayı doğrula!)
# CLAUDE_BIN=claude
# CLAUDE_ARGS=--dangerously-skip-permissions
# CLAUDE_DISPATCH_CMD=                 # doluysa bu shell komutu çalışır ({prompt} değişir) — özel sarmalayıcı

# ════════════════════════════════════════════════════════════════════════
# LOCAL SESLİ DÖNGÜ (Whisper + Ollama beyin + Kokoro). Hepsinin makul default'u
# var; aşağıdakiler yalnızca override için. Donanıma göre OTOMATİK seçilir.
# ════════════════════════════════════════════════════════════════════════

# ─── Beyin (Ollama) ─────────────────────────────────────────────────────
# OLLAMA_URL=http://127.0.0.1:11434   # 'localhost' DEĞİL (Windows IPv6 +2s gecikme)
# GEMMA_MODEL=gemma4:12b              # Windows/güçlü GPU default
# GEMMA_NUM_CTX=8192                  # 27 tool şeması için min 8192
# UNLOAD_ON_SLEEP=1                  # uyku modunda modeli boşalt (7/24 idle RAM)

# ─── STT / endpointing ──────────────────────────────────────────────────
# WHISPER_MODEL_SIZE=small            # small: hızlı+hafif. Doğruluk az gelirse medium
# WHISPER_CPU_THREADS=0               # 0 = otomatik (fiziksel çekirdek)
# WHISPER_LANGUAGE=tr                 # kısa kliplerde sabit dil daha doğru
# VOICE_SILENCE_MS=1000               # cümle bitti sayılan sessizlik
# VOICE_RMS_GATE=300                  # mic'ine göre ayarla (sessiz→düşür, gürültülü→yükselt)

# ─── Wake word (Vosk) ───────────────────────────────────────────────────
# WAKE_WORD=wake up                   # İngilizce → vosk-en-small şart
# VOSK_MODEL_PATH=models/vosk-en-small

# ─── Ekran / telemetri ──────────────────────────────────────────────────
# SCREEN_MONITOR_INDEX=2              # 1=primary, 2=ikinci. MacBook tek ekran → 1
# GPU_VRAM_GB=12                      # boş → otomatik (Mac: unified mem ~%70)

# ════════════════════════════════════════════════════════════════════════
# 🍎 MAC (Apple Silicon, ör. MacBook Air M4 16GB) — ÖNERİLEN OVERRIDE'LAR
# ════════════════════════════════════════════════════════════════════════
# Önce sistem bağımlılıkları (mic/TTS için portaudio şart):
#   brew install portaudio
#   ollama pull qwen2.5:7b-instruct     # 12B M4'te ağır → 7B dispatcher için ideal
# Sonra bu satırların # işaretini kaldır:
#
#   GEMMA_MODEL=qwen2.5:7b-instruct     # 12B yerine — M4'te akıcı, tool-calling sağlam
#   SCREEN_MONITOR_INDEX=1              # tek ekranlı MacBook için
#   GPU_VRAM_GB=16                      # 16GB unified (ya da boş bırak → otomatik)
#   WHISPER_CPU_THREADS=0              # otomatik (M4 çekirdeklerini seçer)
#
# Not: faster-whisper/Kokoro Mac CPU'da çalışır (Metal/CUDA gerekmez). espeak
# kütüphanesi espeakng-loader ile bundle gelir — ayrı kurulum gerekmez.

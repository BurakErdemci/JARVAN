GEMINI_API_KEY=your_gemini_api_key_here

# Antigravity CLI (agy) — arka plan dev/araştırma worker'ı
# Binary PATH'te değilse açıkça ver (Windows kurulumu: %LOCALAPPDATA%\agy\bin\agy.exe).
# Boş bırakılırsa worker otomatik bulur.
# AGY_BIN=
# Model display isimleri (agy models çıktısından)
AGY_MODEL_FAST=Gemini 3.5 Flash (Medium)
AGY_MODEL_HEAVY=Gemini 3.1 Pro (High)
# Ağır görevler için print-mode zaman aşımı (büyük refactor / derin araştırma)
AGY_PRINT_TIMEOUT=30m
